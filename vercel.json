{
  "version": 2,
  "builds": [
    { "src": "api/app.js", "use": "@vercel/node" },
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "style.css", "use": "@vercel/static" },
    { "src": "script.js", "use": "@vercel/static" },
    { "src": "assets/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "source": "/style.css", "dest": "/style.css" },
    { "source": "/script.js", "dest": "/script.js" },
    { "source": "/assets/(.*)", "dest": "/assets/$1" },
    { "source": "/(.*)", "dest": "api/app.js" }
  ]
}